---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Footer from '../components/Footer.astro';
import { education, experiences, projects, profile, skillGroups } from '../data/portfolio';
---
<BaseLayout>
  <div id="top">
    <Header />
    <main id="main-content">
      <section class="hero shell" aria-labelledby="hero-title">
        <div class="availability"><span aria-hidden="true">●</span> Open to backend engineering conversations</div>
        <p class="hero-kicker">TahuTech</p>
        <p class="hero-byline">A personal portfolio by <strong>{profile.name}</strong></p>
        <h1 id="hero-title" class="hero-role">{profile.role}</h1>
        <p class="hero-summary">{profile.summary} I enjoy making existing systems clearer, more dependable, and easier to change.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#projects">View projects <span aria-hidden="true">↘</span></a>
          <a class="button" href="#experience">View experience</a>
          <a class="text-link" href="#contact">Contact me <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section id="about" class="section shell" aria-labelledby="about-title">
        <SectionHeading id="about-title" index="01" eyebrow="Overview" title="About me" />
        <div class="about-grid">
          <div class="about-lead"><p>I’m a backend developer with experience maintaining business applications, building REST APIs, and helping integrations behave predictably in production.</p></div>
          <div class="about-copy"><p>My day-to-day work sits around C#, ASP.NET, .NET Framework, .NET Core, SQL Server, and the practical details of changing established systems safely.</p><p>I value clear boundaries, useful diagnostics, and solutions that are straightforward for the next person to maintain.</p></div>
        </div>
        <div class="principles">
          <article><span class="principle-number">01</span><h3>Maintainable by default</h3><p>Prefer understandable code and small changes that respect the system already in production.</p></article>
          <article><span class="principle-number">02</span><h3>Reliable integration</h3><p>Keep APIs, data, and service boundaries explicit so connected systems can keep moving.</p></article>
        </div>
      </section>

      <section id="experience" class="section shell" aria-labelledby="experience-title">
        <SectionHeading id="experience-title" index="02" eyebrow="Trajectory" title="Work experience" />
        <div class="experience-list">{experiences.map((experience) => <ExperienceItem {...experience} />)}</div>
      </section>

      <section id="skills" class="section shell" aria-labelledby="skills-title">
        <SectionHeading id="skills-title" index="03" eyebrow="Toolkit" title="Technical skills" />
        <p class="section-intro">Specialized in backend and Microsoft technologies, with supporting experience across integrations, databases, and production tooling.</p>
        <div class="skill-grid">{skillGroups.map((group) => <SkillGroup {...group} />)}</div>
      </section>

      <section id="projects" class="section shell" aria-labelledby="projects-title">
        <SectionHeading id="projects-title" index="04" eyebrow="Selected work" title="Featured projects" />
        <p class="section-intro">One learning project is documented today. The remaining slots stay intentionally open for work that can be shared publicly.</p>
        <div class="project-list">{projects.map((project) => <ProjectCard {...project} />)}</div>
      </section>

      <section id="education" class="section shell" aria-labelledby="education-title">
        <SectionHeading id="education-title" index="05" eyebrow="Background" title="Education & publication" />
        <div class="education-list">
          {education.map((item) => <article class="education-item"><div><h3>{item.degree}</h3><p>{item.institution}</p></div><div><p class="mono">{item.period}</p><p>{item.note}</p></div></article>)}
          <article class="publication"><p class="section-index">Publication</p><h3>Application of C4.5 Classification Algorithm for Chronic Kidney Disease Diagnosis</h3><p>IEEE · February 2020</p></article>
        </div>
      </section>

      <section class="origin shell" aria-labelledby="origin-title">
        <div><p class="section-index">A light origin story</p><h2 id="origin-title">Why TahuTech?</h2><p>“I like technology. I also really like tahu tek. The name stuck.”</p></div>
        <p>TahuTech is a small reminder to keep the work grounded: honest ingredients, careful preparation, and something dependable at the end.</p>
      </section>

      <section id="contact" class="section contact-section shell" aria-labelledby="contact-title">
        <div class="contact-copy"><SectionHeading id="contact-title" index="06" eyebrow="Contact" title="Let’s build reliable systems" /><p>If you’re working on a backend problem, improving an existing .NET system, or looking for a pragmatic engineering partner, I’d be glad to hear from you.</p></div>
        <div class="contact-links">
          <a class="contact-link" href={`mailto:${profile.email}`}><span>Email</span><strong>{profile.email}</strong><span aria-hidden="true">↗</span></a>
          <a class="contact-link" href={profile.linkedin} target="_blank" rel="noreferrer"><span>LinkedIn</span><strong>Connect on LinkedIn</strong><span aria-hidden="true">↗</span></a>
          <a class="contact-link" href={profile.github} target="_blank" rel="noreferrer"><span>GitHub</span><strong>See my code</strong><span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>
    
    <script is:inline>
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries, currentObserver) => {
          entries.filter((entry) => entry.isIntersecting).forEach((entry) => {
            entry.target.classList.add('is-visible');
            currentObserver.unobserve(entry.target);
          });
        }, { threshold: 0.12 });

        document.querySelectorAll('main > .section, main > .origin').forEach((section) => {
          observer.observe(section);
        });
      }
    </script>
    <Footer />
  </div>
</BaseLayout>
