---
interface Props {
  company: string; role: string; period: string; context: string; description: string;
  highlights: string[]; technologies: string[];
}
const { company, role, period, context, description, highlights, technologies } = Astro.props;
---
<article class="experience-item">
  <div class="experience-meta">
    <p class="mono">{period}</p>
    <h3>{role}</h3>
    <p>{company}</p>
    <small>{context}</small>
  </div>
  <div class="experience-body">
    <p class="lead-copy">{description}</p>
    <ul>{highlights.map((highlight) => <li>{highlight}</li>)}</ul>
    <div class="tags" aria-label="Technologies used">
      {technologies.map((technology) => <span>{technology}</span>)}
    </div>
  </div>
</article>
